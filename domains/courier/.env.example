# Courier domain service (отдельный процесс).
# uvicorn domains.courier.main:app --host 127.0.0.1 --port 8100
# Скопируйте в domains/courier/.env — не коммитьте .env.
#
# Platform узнаёт tenant через domain_services + domain_secrets
# (PUT /v1/{service_id}/secrets), не через этот файл.

SERVICE_ID=svc_courier_01
DOMAIN_DATABASE_URL=mysql+mysqlconnector://user:pass@host:3306/domain_db

# HMAC с platform: то же значение → domain_secrets.contract_shared_secret
CONTRACT_SHARED_SECRET=change-me-same-as-platform

# Временно: CORE credential всё ещё читается из platform domain_secrets.
# Удалить после реализации изоляции credentials (§9.7 основной спецификации).
PLATFORM_DATABASE_URL=mysql+mysqlconnector://user:pass@host:3306/platform_db
PLATFORM_SECRETS_KEY=

# contract_base_url, graph URLs и Telegram задаются через platform secrets API,
# а не через env domain process.
