# FSM Platform process environment (example)

PLATFORM_DATABASE_URL=mysql+mysqlconnector://user:pass@host:3306/platform_db
PLATFORM_SECRETS_KEY=
PLATFORM_ADMIN_TOKEN=

# Tenant auth
TENANT_AUTH_SECRET=replace-with-at-least-32-random-characters
TENANT_AUTH_EXPOSE_TOKENS=0
TENANT_ACCESS_TOKEN_TTL_SECONDS=900
TENANT_REFRESH_TOKEN_TTL_SECONDS=2592000
TENANT_EMAIL_TOKEN_TTL_SECONDS=86400

# Optional SMTP for email verification (or set TENANT_AUTH_EXPOSE_TOKENS=1 locally)
# TENANT_SMTP_HOST=
# TENANT_SMTP_PORT=587
# TENANT_SMTP_STARTTLS=1
# TENANT_SMTP_USERNAME=
# TENANT_SMTP_PASSWORD=
# TENANT_SMTP_FROM=noreply@example.com
# TENANT_VERIFY_URL=http://localhost:8000/verify-email

# Worker (dedicated process)
WORKER_SERVICE_ID=svc_example_01
FSM_WORKER_POLL_SECONDS=1
LOG_LEVEL=INFO

# Optional actor Bearer auth for invoke body actor overrides
PLATFORM_AUTH_SECRET=
PLATFORM_AUTH_DEV_TOKENS=0
